<compatibility>
	<!--
		Lowest Innovator release this package installs into. That release and
		every later one are accepted. Tested on 14.0.25 (Innovator 2024) and
		14.35.0 (Innovator 2025).

		The value is compared as a version number against
		Client/scripts/include/rev.inc (Client Code Tree module) and the
		connected server's release (Database module).
	-->
	<minimum_innovator version="14.0.25" />
</compatibility>

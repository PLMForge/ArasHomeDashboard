<?xml version="1.0" encoding="utf-8"?>
<package>
	<info>
		<name>FRG_DashboardWidgets</name>
		<label>FRG Dashboard Widgets</label>
		<version>1.0.0</version>
		<version_label>Release 1 (1.0.0)</version_label>
		<type>aia</type>
		<owner>FRG</owner>
		<description>Gives Aras Innovator users a friendlier home page. Adds five dashboard widgets (In-Basket Tasks: the user's active workflow tasks, split into direct and group assignments; Pinned ItemTypes: the ItemTypes the user has pinned, as tiles; Favorites: the items the user has starred; Recently Viewed: the items the user has opened, kept between sessions; Quick Find: a search box across chosen ItemTypes) and a ready-made Home dashboard that shows the first four. Deploys the widget modules to the Innovator client code tree, registers them through the dashboard bundle's public addWidgetLayout API, and imports the widget types, the templates and the Home dashboard into the database.</description>
		<copyright>FRG</copyright>
		<!--
			Requires Aras Update 1.18 or later, which checks up front that
			Innovator.Dir contains both Client and Server and reports a clear
			message if it does not.

			An older Aras Update does not show this package in its list at all.
		-->
		<tool_minimal_version_required>1.18</tool_minimal_version_required>
	</info>

	<installation>
		<!--
			=====================================================================
			MAINTAINER NOTE - read before editing any attribute value below.

			In attribute values and element text, Aras Update treats lowercase
			"not" and uppercase "AND" / "OR" as expression operators, even inside
			other words. Avoid words such as "cannot", "nothing" or "ERROR" in
			messages. Comments are unaffected. Check with:
			    grep -oE 'message="[^"]*"' package.config | grep -nE 'not|AND|OR'
			=====================================================================

			Code tree module.

			Copies the FRG_*.js modules into Client/customer/dashboard/, bumps
			filesRevision, then splices a small managed block into
			dashboardEditorView.cshtml. The splice is idempotent and aborts the
			install rather than half-applying - see the script under Scripts/.
		-->
		<module id="IS" label="@{Pkg.IS.Label}" description="@{Pkg.IS.Desc}" required_properties="Innovator.Dir">

			<dependencies>
				<!--
					PREFLIGHT. Both files this module reads must exist before anything
					runs, so a wrong Innovator.Dir fails here with a clear message
					instead of partway through the install.

					The property is set to "false" first on purpose: the check passes
					only once both files have been found.
				-->
				<custom property="FRG.Preflight">
					<property name="FRG.Preflight" value="false" />
					<property name="RevInc" value="${Innovator.Dir}\Client\scripts\include\rev.inc" />
					<property name="Client.Config" value="${Innovator.Dir}\Client\InnovatorClient.config" />
					<if test="${file::exists(RevInc)}">
						<if test="${file::exists(Client.Config)}">
							<property name="FRG.Preflight" value="true" />
						</if>
					</if>
					<if test="${not(file::exists(RevInc))}">
						<echo message="PREFLIGHT FAILED: missing ${RevInc} - check the Install Path. It must be the Innovator folder holding Client and Server." />
					</if>
					<if test="${not(file::exists(Client.Config))}">
						<echo message="PREFLIGHT FAILED: missing ${Client.Config} - check the Install Path." />
					</if>
				</custom>

				<custom property="Version.Check">
					<property name="Version.Check" value="false" />
					<property name="RevInc.Label" value="" />
					<!-- encoding is explicit so that a UTF-8 BOM in rev.inc cannot break
					     the version comparison below. -->
					<loadfile file="${RevInc}" property="RevInc.Label" encoding="utf-8" />
					<!-- Any release at or above the minimum in compatibility.config is
					     accepted. System.Version compares numerically, so 14.100.0 is
					     correctly later than 14.35.0. The empty checks matter: Aras Update
					     also evaluates this before the properties are loaded. -->
					<property name="MinimumRelease" value="" />
					<xmlpeek file="${Package.Dir}\compatibility.config" xpath="/compatibility/minimum_innovator/@version" property="MinimumRelease" failonerror="false" />
					<echo message="Detected Innovator release: ${RevInc.Label} (minimum supported: ${MinimumRelease})" />
					<if test="${RevInc.Label != '' AND MinimumRelease != '' AND System.Version.Parse(RevInc.Label) &gt;= System.Version.Parse(MinimumRelease)}">
						<property name="Version.Check" value="true" />
					</if>
				</custom>
			</dependencies>

			<!--
				Bump filesRevision in InnovatorClient.config (not web.config). This is
				the ONLY cache-busting mechanism this package uses: the FRG files are
				referenced through salted URLs that include filesRevision, so changing
				it makes browsers fetch the new files.

				Convention: the default "std" becomes "1" on the first install, and
				every later install increments it by 1.
			-->
			<property name="FilesRevisionXpath" value="/configuration/cachingModule/@filesRevision" />
			<property name="OldFilesRevision" value="" />
			<xmlpeek file="${Client.Config}" xpath="${FilesRevisionXpath}" property="OldFilesRevision" />

			<!--
				Stop with a clear message if InnovatorClient.config has no
				filesRevision value to bump. "cmd /c exit 1" is how the install is
				failed deliberately.
			-->
			<if test="${string::get-length(OldFilesRevision) == 0}">
				<echo message="FAILED: no ${FilesRevisionXpath} found in ${Client.Config}. The cachingModule element is missing - this release may keep filesRevision elsewhere." />
				<exec program="cmd.exe" commandline="/c exit 1" failonerror="true" />
			</if>

			<property name="NewFilesRevision" value="" />
			<if test="${OldFilesRevision == 'std'}">
				<property name="NewFilesRevision" value="1" />
			</if>
			<if test="${OldFilesRevision != 'std'}">
				<property name="NewFilesRevision" value="${int::parse(OldFilesRevision) + 1}" />
			</if>
			<!-- preservewhitespace keeps the rest of the config's formatting
			     unchanged. -->
			<xmlpoke file="${Client.Config}" xpath="${FilesRevisionXpath}" value="${NewFilesRevision}" preservewhitespace="true" />
			<echo message="Client cache token: ${OldFilesRevision} -> ${NewFilesRevision}" />

			<!-- Our own files: whole-file copy, no merge needed. -->
			<copy todir="${Innovator.Dir}/Client/customer/dashboard/" failonerror="true">
				<fileset basedir="${Package.Dir}/Innovator/Client/customer/dashboard/">
					<include name="**" />
				</fileset>
			</copy>

			<!--
				The only edit this package makes to an existing Innovator file.

				The recently-viewed capture starts from FRG_registerWidgets.js when
				a dashboard editor first opens, and picks up every item still open
				at that moment. Items opened and closed before the first dashboard
				of a session are not recorded; in exchange the package edits only
				this one file.
			-->
			<property name="FRG.DashboardView" value="${Innovator.Dir}/Client/Modules/aras.innovator.core.ItemWindow/Views/dashboardEditorView.cshtml" />
			<!--
				NO output= attribute, deliberately: without one, the script's messages
				(including the reason for a refusal) are written to the installer log,
				where someone diagnosing a failed install will look.
			-->
			<exec program="powershell.exe"
			      workingdir="${Package.Dir}/Scripts"
			      commandline="-ExecutionPolicy Unrestricted -NonInteractive -File FRG_injectDashboardView.ps1 -Path &quot;${FRG.DashboardView}&quot;"
			      failonerror="true" />

			<!--
				The Client app reads filesRevision only at startup, so restart it
				(that app alone, not its application pool) for the new cache salt
				to take effect.
			-->
			<exec program="powershell.exe"
			      workingdir="${Package.Dir}/Scripts"
			      commandline="-ExecutionPolicy Unrestricted -NonInteractive -File FRG_restartClientApp.ps1 -ClientDir &quot;${Innovator.Dir}\Client&quot;"
			      failonerror="true" />
		</module>

		<!--
			Database module.

			Imports the AML under Imports/ (see imports.mf): the five Dashboard
			Widget Templates and the Home dashboard, plus the Fixes/ AML that adds
			the widget types to the Dashboard Widget Types list and the
			cust_recent_items property to Core_GlobalLayout. Then shares Home with
			World where the release supports dashboard sharing (see below). Safe
			to re-run: existing items are updated in place.
		-->
		<module id="DB" label="@{Pkg.DB.Label}" description="@{Pkg.DB.Desc}" required_properties="Innovator.URL|Innovator.DB|Innovator.Username|Innovator.Password">

			<dependencies>
				<custom property="Version.Check">
					<property name="Version.Check" value="false" />
					<property name="MinimumRelease" value="" />
					<xmlpeek file="${Package.Dir}\compatibility.config" xpath="/compatibility/minimum_innovator/@version" property="MinimumRelease" failonerror="false" />
					<echo message="Connected Innovator release: ${Innovator.Release} (minimum supported: ${MinimumRelease})" />
					<if test="${Innovator.Release != '' AND MinimumRelease != '' AND System.Version.Parse(Innovator.Release) &gt;= System.Version.Parse(MinimumRelease)}">
						<property name="Version.Check" value="true" />
					</if>
				</custom>
			</dependencies>

			<import dir="${Package.Dir}/Imports/" failonerror="true" />

			<!--
				SHARE THE HOME DASHBOARD WITH WORLD (read-only)

				Dashboard sharing (the Dashboard_AccessSharing relationship) does
				not exist on every supported release: 14.0.25 has no such ItemType
				and shows dashboards to the Dashboard Viewers identity instead. A
				share row in the imported AML would fail the whole import there,
				so it is applied here, only where the ItemType exists.

				How the checks work, and why they look like this:
				- An applyaml exec whose query finds nothing throws, and
				  failonerror="false" turns that into a warning.
				- property::exists CANNOT tell success from failure: a property
				  named by an exec exists even when the exec failed (verified on
				  Aras Update 1.25).
				- The response XML cannot be used in an <if> test either: a
				  property value inside an expression is wrapped in single quotes
				  and every quote is then turned into a double quote, so the
				  response's own quotes break the compiled expression.
				- So each response is fed to xmlpeek through the exact form
				  text="${Name}", which is XML-escaped and never compiled. The
				  id it extracts (32 hex characters) replaces a seeded "none".
				  On a failed lookup the text is empty, xmlpeek fails quietly,
				  and the seed stays.

				The second lookup keeps a re-install from adding a duplicate
				share. Adding the share runs the dashboard's own server events,
				which put World into the dashboard's sharing team. Home's id is
				fixed in Imports/FRG_DashboardWidgets/cui_Dashboard/Home.xml.

				Everything inside an <if> passes through the AND/OR/not text
				replacement (see the maintainer note at the top), AML included.
			-->
			<property name="FRG.SharingTypeId" value="none" />
			<property name="FRG.HomeShareId" value="none" />
			<exec action="applyaml" property="FRG.SharingTypeResponse" failonerror="false">
				<AML>
					<Item type="ItemType" action="get" select="id">
						<name>Dashboard_AccessSharing</name>
					</Item>
				</AML>
			</exec>
			<xmlpeek text="${FRG.SharingTypeResponse}" xpath="//Item/@id" property="FRG.SharingTypeId" failonerror="false" />
			<if test="${FRG.SharingTypeId != 'none'}">
				<exec action="applyaml" property="FRG.HomeShareResponse" failonerror="false">
					<AML>
						<Item type="Dashboard_AccessSharing" action="get" select="id">
							<source_id>28D061D9ACB041CC8E6D9E5AAF225EF5</source_id>
							<related_id>
								<Item type="Identity" action="get" select="id">
									<name>World</name>
								</Item>
							</related_id>
						</Item>
					</AML>
				</exec>
				<xmlpeek text="${FRG.HomeShareResponse}" xpath="//Item/@id" property="FRG.HomeShareId" failonerror="false" />
				<if test="${FRG.HomeShareId == 'none'}">
					<echo message="Sharing the Home dashboard with World (Viewer)" />
					<exec action="applyaml" failonerror="true">
						<AML>
							<Item type="cui_Dashboard" id="28D061D9ACB041CC8E6D9E5AAF225EF5" action="edit">
								<Relationships>
									<Item type="Dashboard_AccessSharing" action="add">
										<related_id>
											<Item type="Identity" action="get" select="id">
												<name>World</name>
											</Item>
										</related_id>
										<sharing_mode>Viewer</sharing_mode>
									</Item>
								</Relationships>
							</Item>
						</AML>
					</exec>
				</if>
			</if>
		</module>
	</installation>
</package>
